#!/usr/bin/env bash
# Usage: ./run app | ./run desk|gestures|ascii|train [options]   (add --help after the name for options)
set -euo pipefail
cd "$(dirname "$0")"

case "${1:-}" in
  app)
    APP="$HOME/Desktop/Desk Guard.app"
    [ -d "$APP" ] || tools/make_app.sh
    exec open "$APP" ;;
  desk)     module=desk ;;
  gestures) module=gestures ;;
  ascii)    module=ascii_cam ;;
  train)    module=train_face ;;
  *) echo "usage: ./run app | ./run desk|gestures|ascii|train [options]"; exit 1 ;;
esac
shift

if [ ! -x .venv/bin/python ]; then
  echo "Setting up the Python environment (first run only)..."
  uv venv -q --managed-python --python 3.12 .venv  # native arm64, not a Rosetta Python
  uv pip install -q --python .venv/bin/python -r requirements.txt
fi

body_model=models/selfie_segmenter.tflite
if [ ! -f "$body_model" ]; then
  curl -sL --fail -o "$body_model.part" \
    "https://storage.googleapis.com/mediapipe-models/image_segmenter/selfie_segmenter/float16/latest/selfie_segmenter.tflite"
  mv "$body_model.part" "$body_model"
fi

face_id_model=models/face_recognition_sface_2021dec.onnx
if [ ! -f "$face_id_model" ]; then
  echo "Downloading the face recognition model (37 MB, first run only)..."
  curl -L --fail -o "$face_id_model.part" \
    "https://github.com/opencv/opencv_zoo/raw/main/models/face_recognition_sface/face_recognition_sface_2021dec.onnx"
  mv "$face_id_model.part" "$face_id_model"
fi

exec .venv/bin/python -m "webcam_fun.$module" "$@"
